# An archive is located before trailing bytes, reading its blocks from the start.
{
  "title": "An archive before trailing bytes",
  "spec": ["#locating-an-archive"],
  "level": 0,
  "archive": {
    "header_magic": "HEADER_MAGIC",
    "blocks": [
      {"type": 0x20, "data": {"uncompressed_data": {"data": 'Hello, world'}}},
    ],
    "footer_magic": "FOOTER_MAGIC",
  },
  "trailing": 'appended by a transfer',
  "interpreted": {"root": {"content": 'Hello, world'}},
}
