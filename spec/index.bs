    <tr>
      <th>Name
      <th>Type
      <th>Conditions
  </thead>
  <tbody>
    <tr>
      <td><dfn>apply_module</dfn>
      <td>[=leb128=]
      <td>
    <tr>
      <td><dfn>apply_num_resources</dfn>
      <td>[=leb128=]
      <td>
    <tr>
      <td><dfn>apply_resources</dfn>
      <td>[=leb128=][[=formula/apply_num_resources=]]
      <td>
    <tr>
      <td><dfn>apply_params_size</dfn>
      <td>[=leb128=]
      <td>
    <tr>
      <td><dfn>apply_params</dfn>
